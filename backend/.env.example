# Server
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/shree_krishna_edutech?retryWrites=true&w=majority

# Allowed frontend origins (comma separated)
FRONTEND_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,https://shreekrishnaedutech.com,https://www.shreekrishnaedutech.com

# MSG91 V5 OTP API
# Keep these values only on the backend. NEVER put the authkey in HTML/JS.
MSG91_AUTHKEY=YOUR_MSG91_AUTHKEY
MSG91_TEMPLATE_ID=YOUR_MSG91_TEMPLATE_ID
MSG91_OTP_LENGTH=6
MSG91_OTP_EXPIRY_MINUTES=10

# Optional: Google Apps Script Web App URL for copying registrations to Google Sheets
GOOGLE_APPS_SCRIPT_URL=

# JWT for future login/session APIs
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d
